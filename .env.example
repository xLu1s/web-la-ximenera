# ---------- Supabase ----------
# Proyecto > Settings > API. La anon/publishable key es pública (protegida por RLS).
PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
PUBLIC_SUPABASE_ANON_KEY=
# SOLO servidor. Nunca en el navegador ni en el repositorio.
SUPABASE_SERVICE_ROLE_KEY=

# ---------- Web ----------
# URL pública (enlaces de cancelación, recuperación de contraseña, canonical/SEO).
PUBLIC_SITE_URL=https://tu-dominio.es
# Secreto para firmar los enlaces de cancelación (mín. 32 caracteres aleatorios: `openssl rand -hex 32`).
BOOKING_TOKEN_SECRET=

# ---------- Emails (Resend) ----------
RESEND_API_KEY=
# Con onboarding@resend.dev, Resend SOLO entrega al email del dueño de la cuenta Resend
# hasta verificar un dominio propio. Después: "La Ximenera <reservas@tu-dominio.es>".
EMAIL_FROM="La Ximenera <onboarding@resend.dev>"
OWNER_NOTIFY_EMAIL=luisbalaguer97@gmail.com
# Opcional: dirección a la que responden los clientes.
EMAIL_REPLY_TO=

# ---------- Anti-spam (opcional) ----------
BOOKING_RATE_LIMIT_MAX=5
BOOKING_RATE_LIMIT_WINDOW_SECONDS=600
