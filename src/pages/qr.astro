---
export const prerender = false;
import Base from '../layouts/Base.astro';
import { publicLang, t } from '../i18n/public';
import { QR_TARGET } from '../lib/qr';
const lang = publicLang(Astro.locals.lang);
---
<Base title={`${t(lang, 'qr.title')} · La Ximenera`} description={t(lang, 'qr.lead')} structuredData={false}>
  <main id="contenido" class="legal">
    <div class="container" style="text-align:center;padding:6rem 0 4rem">
      <h1>{t(lang, 'qr.title')}</h1>
      <p>{t(lang, 'qr.lead')}</p>
      <p><img src="/qr.png" width="320" height="320" alt={t(lang, 'qr.title')} /></p>
      <p><a href={QR_TARGET}>{QR_TARGET}</a></p>
      <p class="qr-actions">
        <button class="btn btn--gold" type="button" onclick="window.print()">{t(lang, 'qr.print')}</button>
        <a class="btn btn--outline" href="/qr.png" download="la-ximenera-qr.png">{t(lang, 'qr.download')}</a>
      </p>
      <p><a href="/">{t(lang, 'qr.back')}</a></p>
    </div>
  </main>
</Base>
<style>
  .qr-actions { display: flex; flex-wrap: wrap; gap: .75rem; justify-content: center; }
  @media print {
    .header, .footer, .qr-actions, .skip-link { display: none !important; }
  }
</style>
