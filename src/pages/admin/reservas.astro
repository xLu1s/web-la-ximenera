---
export const prerender = false;
import Admin from '../../layouts/Admin.astro';
import { addDays, formatDateEs, isValidDate, todayMadrid } from '../../lib/time';
import { SERVICE_LABEL, type ServiceStatus } from '../../lib/hours';
import { dbErrorMessage, faction, fid, fint, fstr, redirectWith } from '../../lib/admin';
import { customerCancellation, ownerCancellation, sendEmail } from '../../lib/email';

const sb = Astro.locals.supabase;
const qDay = Astro.url.searchParams.get('fecha') ?? '';
const day = isValidDate(qDay) ? qDay : todayMadrid();
const here = `/admin/reservas?fecha=${day}`;

if (Astro.request.method === 'POST') {
  const fd = await Astro.request.formData();
  const action = faction(fd);
  if (action === 'cancel') {
    const id = fstr(fd, 'booking_id');
    const { data, error } = await sb.rpc('admin_cancel_booking', { p_id: id });
    if (error) return redirectWith(here, dbErrorMessage(error), 'err');
    if (!data.ok) return redirectWith(here, data.error === 'already_cancelled' ? 'La reserva ya estaba cancelada.' : 'No se encontró la reserva.', 'err');
    const s = { reference: data.reference, day: data.day, time: data.time, service: data.service, party_size: data.party_size, name: data.name, email: data.email };
    if (fstr(fd, 'notify') === 'on') await sendEmail(customerCancellation(s));
    await sendEmail(ownerCancellation(s, 'restaurante'));
    return redirectWith(here, `Reserva ${data.reference} cancelada.`);
  }
  if (action === 'block' || action === 'capacity') {
    const service = fstr(fd, 'service') || null;
    const targetDay = isValidDate(fstr(fd, 'day')) ? fstr(fd, 'day') : day;
    const note = fstr(fd, 'note').slice(0, 200) || null;
    const row = action === 'block'
      ? { day: targetDay, service, closed: true, capacity: null, note }
      : { day: targetDay, service, closed: false, capacity: Math.max(0, fint(fd, 'capacity', 0)), note };
    if (action === 'capacity' && (fstr(fd, 'capacity') === '' || row.capacity! > 1000)) return redirectWith(here, 'Escribe un aforo entre 0 y 1000.', 'err');
    const { error } = await sb.from('service_exceptions').upsert(row, { onConflict: 'day,service_key' });
    if (error) return redirectWith(here, dbErrorMessage(error), 'err');
    const what = service ? SERVICE_LABEL[service as 'comida'] : 'Todo el día';
    return redirectWith(`/admin/reservas?fecha=${targetDay}`, action === 'block' ? `${what} bloqueado el ${formatDateEs(targetDay)}.` : `Aforo de ${what.toLowerCase()} ajustado a ${row.capacity} personas.`);
  }
  if (action === 'unblock') {
    const id = fid(fd);
    const { error } = await sb.from('service_exceptions').delete().eq('id', id!);
    if (error) return redirectWith(here, dbErrorMessage(error), 'err');
    return redirectWith(here, 'Excepción eliminada.');
  }
  return redirectWith(here, 'Acción desconocida.', 'err');
}

const [statusRes, bookingsRes, exRes] = await Promise.all([
  sb.rpc('admin_day_status', { p_day: day }),
  sb.from('bookings').select('*').eq('day', day).order('booking_time').order('created_at'),
  sb.from('service_exceptions').select('*').eq('day', day).order('service', { nullsFirst: true }),
]);
const status = (statusRes.data ?? []) as ServiceStatus[];
const bookings = bookingsRes.data ?? [];
const exceptions = exRes.data ?? [];
const totalPeople = bookings.filter((b) => b.status === 'confirmada').reduce((n, b) => n + b.party_size, 0);
---
<Admin title="Reservas" section="reservas">
  <form class="card row" method="get">
    <a class="btn btn--light" href={`/admin/reservas?fecha=${addDays(day, -1)}`} aria-label="Día anterior">‹</a>
    <label class="f f--grow">Día <input type="date" name="fecha" value={day} onchange="this.form.submit()" /></label>
    <a class="btn btn--light" href={`/admin/reservas?fecha=${addDays(day, 1)}`} aria-label="Día siguiente">›</a>
    <a class="btn btn--light" href="/admin/reservas">Hoy</a>
    <noscript><button class="btn" type="submit">Ver</button></noscript>
  </form>
  <p><strong>{(() => { const t = formatDateEs(day); return t.charAt(0).toUpperCase() + t.slice(1); })()}</strong> · {totalPeople} personas reservadas</p>

  {status.length === 0 && <p class="card card--muted">Este día el restaurante está cerrado según el horario semanal (puedes cambiarlo en «Horarios y ajustes»).</p>}

  {status.map((s) => {
    const list = bookings.filter((b) => b.service === s.service);
    const pct = s.capacity > 0 ? Math.min(100, Math.round((s.booked / s.capacity) * 100)) : 100;
    return (
      <section class="card" data-service={s.service}>
        <div class="row" style="justify-content:space-between;align-items:center">
          <h2 style="margin:0">{SERVICE_LABEL[s.service]} <small class="help">{s.opens.slice(0, 5)}–{s.closes.slice(0, 5) === '24:00' ? '00:00' : s.closes.slice(0, 5)} · última reserva {s.last_booking.slice(0, 5)}</small></h2>
          {s.is_closed ? <span class="badge badge--err">Bloqueado{s.closed_note ? `: ${s.closed_note}` : ''}</span>
            : s.booked >= s.capacity ? <span class="badge badge--err">Completo</span> : <span class="badge badge--ok">Abierto</span>}
        </div>
        <p style="margin:.6rem 0 0" data-occupancy>{s.booked} / {s.capacity} personas</p>
        <div class:list={['occ', { 'occ--full': s.booked >= s.capacity }]}><span style={`width:${pct}%`}></span></div>
        {list.length === 0 ? <p class="help">Sin reservas.</p> : (
          <table class="bookings">
            <thead><tr><th>Hora</th><th>Pers.</th><th>Nombre</th><th>Contacto</th><th>Observaciones</th><th>Ref.</th><th></th></tr></thead>
            <tbody>
              {list.map((b) => (
                <tr class:list={{ 'is-cancelled': b.status === 'cancelada' }} data-booking={b.reference}>
                  <td><strong>{b.booking_time.slice(0, 5)}</strong></td>
                  <td>{b.party_size}</td>
                  <td>{b.name}</td>
                  <td><a href={`tel:${b.phone}`}>{b.phone}</a><br /><a href={`mailto:${b.email}`}>{b.email}</a></td>
                  <td>{b.notes ?? ''}</td>
                  <td><code>{b.reference}</code></td>
                  <td>
                    {b.status === 'confirmada' ? (
                      <form method="post" data-confirm={`¿Cancelar la reserva ${b.reference} de ${b.name}?`}>
                        <input type="hidden" name="action" value="cancel" />
                        <input type="hidden" name="booking_id" value={b.id} />
                        <label class="f--check" style="font-size:.8rem"><input type="checkbox" name="notify" checked /> avisar al cliente</label>
                        <button class="btn btn--danger btn--small" type="submit">Cancelar</button>
                      </form>
                    ) : <span class="badge">Cancelada{b.cancelled_by ? ` (${b.cancelled_by})` : ''}</span>}
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        )}
      </section>
    );
  })}

  <h2>Bloquear o cambiar el aforo de este día</h2>
  {exceptions.length > 0 && (
    <div class="card card--muted">
      <h3>Excepciones del {formatDateEs(day)}</h3>
      {exceptions.map((e) => (
        <form method="post" class="row" style="align-items:center;margin-bottom:.4rem">
          <input type="hidden" name="action" value="unblock" /><input type="hidden" name="id" value={e.id} />
          <span>{e.service ? SERVICE_LABEL[e.service as 'comida'] : 'Todo el día'}: {e.closed ? 'bloqueado' : `aforo ${e.capacity} personas`}{e.note ? ` · ${e.note}` : ''}</span>
          <button class="btn btn--light btn--small" type="submit">Quitar</button>
        </form>
      ))}
    </div>
  )}
  <div class="grid">
    <form method="post" class="card" data-form="block">
      <h3>Bloquear reservas online</h3>
      <input type="hidden" name="action" value="block" />
      <label class="f">Día <input type="date" name="day" value={day} required /></label>
      <label class="f">Servicio <select name="service"><option value="">Todo el día</option><option value="comida">Comida</option><option value="cena">Cena</option></select></label>
      <label class="f">Motivo (interno, opcional) <input type="text" name="note" maxlength="200" placeholder="Evento privado, vacaciones…" /></label>
      <div class="actions"><button class="btn" type="submit">Bloquear</button></div>
    </form>
    <form method="post" class="card" data-form="capacity">
      <h3>Ajustar aforo</h3>
      <input type="hidden" name="action" value="capacity" />
      <label class="f">Día <input type="date" name="day" value={day} required /></label>
      <label class="f">Servicio <select name="service"><option value="comida">Comida</option><option value="cena">Cena</option><option value="">Todo el día</option></select></label>
      <label class="f">Plazas (personas) <input type="number" name="capacity" min="0" max="1000" required /></label>
      <div class="actions"><button class="btn" type="submit">Guardar aforo</button></div>
    </form>
  </div>
</Admin>
