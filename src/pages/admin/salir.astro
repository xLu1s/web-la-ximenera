---
export const prerender = false;
if (Astro.request.method === 'POST') {
  await Astro.locals.supabase.auth.signOut();
  return Astro.redirect('/admin/login?ok=' + encodeURIComponent('Has cerrado la sesión.'), 303);
}
import Admin from '../../layouts/Admin.astro';
---
<Admin title="Cerrar sesión" bare>
  <form method="post"><button class="btn" type="submit">Cerrar sesión</button></form>
</Admin>
