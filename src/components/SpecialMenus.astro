---
import { menuImageUrl, type SpecialMenuRow } from '../lib/content';
import { formatDateEs } from '../lib/time';
interface Props { specials: SpecialMenuRow[] }
const { specials } = Astro.props;
const shortDate = (d: string) => formatDateEs(d).replace(/^[^,]+, /, '').replace(/ de \d{4}$/, '');
const range = (m: SpecialMenuRow) =>
  m.starts_on && m.ends_on ? (m.starts_on === m.ends_on ? `El ${shortDate(m.starts_on)}` : `Del ${shortDate(m.starts_on)} al ${shortDate(m.ends_on)}`)
  : m.ends_on ? `Hasta el ${shortDate(m.ends_on)}` : m.starts_on ? `Desde el ${shortDate(m.starts_on)}` : '';
---
{specials.length > 0 && (
<section id="menus-especiales" class="section specials" aria-labelledby="specials-title">
  <div class="container">
    <div class="section__head reveal">
      <p class="eyebrow">Solo por unos días</p>
      <h2 id="specials-title">Menús <em>especiales</em></h2>
    </div>
    <div class="specials__list">
      {specials.map((m) => (
        <article class:list={['special reveal', { 'special--image': m.image_path }]} data-special>
          {m.image_path && <img class="special__img" src={menuImageUrl(m.image_path)} alt={`Imagen del ${m.title}`} loading="lazy" />}
          <div class="special__body">
            {(range(m) || m.subtitle) && <p class="eyebrow">{[m.subtitle, range(m)].filter(Boolean).join(' · ')}</p>}
            <h3>{m.title}</h3>
            {m.description && <p class="special__desc">{m.description}</p>}
            {m.courses.length > 0 && (
              <div class="special__courses">
                {m.courses.map((c) => (
                  <div class="menu-day__course">
                    {c.title && <h4>{c.title}</h4>}
                    <ul role="list">{c.items.map((i) => <li>{i}</li>)}</ul>
                  </div>
                ))}
              </div>
            )}
            <div class="special__foot">
              {m.price && <p class="menu-day__price">{m.price}</p>}
              {m.price_note && <p class="menu-day__note">{m.price_note}</p>}
              <a class="btn btn--outline" href="#reservar">Reserva tu mesa</a>
            </div>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>
)}
