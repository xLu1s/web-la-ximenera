---
import { menuImageUrl, type SpecialMenuRow } from '../lib/content';
import { formatDateEs } from '../lib/time';
import { publicLang, t } from '../i18n/public';
interface Props { specials: SpecialMenuRow[] }
const { specials } = Astro.props;
const lang = publicLang(Astro.locals.lang);
const shortDate = (d: string) => {
  if (lang === 'en') return new Intl.DateTimeFormat('en-GB', { day: 'numeric', month: 'long', timeZone: 'UTC' }).format(new Date(`${d}T12:00:00Z`));
  return formatDateEs(d).replace(/^[^,]+, /, '').replace(/ de \d{4}$/, '');
};
const range = (m: SpecialMenuRow) =>
  m.starts_on && m.ends_on
    ? (m.starts_on === m.ends_on ? t(lang, 'specials.on', { date: shortDate(m.starts_on) }) : t(lang, 'specials.range', { a: shortDate(m.starts_on), b: shortDate(m.ends_on) }))
    : m.ends_on ? t(lang, 'specials.until', { date: shortDate(m.ends_on) })
    : m.starts_on ? t(lang, 'specials.since', { date: shortDate(m.starts_on) })
    : '';
---
{specials.length > 0 && (
<section id="menus-especiales" class="section specials" aria-labelledby="specials-title">
  <div class="container">
    <div class="section__head reveal">
      <p class="eyebrow">{t(lang, 'specials.eyebrow')}</p>
      <h2 id="specials-title" set:html={t(lang, 'specials.title')} />
    </div>
    <div class="specials__list">
      {specials.map((m) => (
        <article class:list={['special reveal', { 'special--image': m.image_path }]} data-special>
          {m.image_path && <img class="special__img" src={menuImageUrl(m.image_path)} alt={t(lang, 'specials.alt', { title: m.title })} loading="lazy" />}
          <div class="special__body">
            {(range(m) || m.subtitle) && <p class="eyebrow">{[m.subtitle, range(m)].filter(Boolean).join(' · ')}</p>}
            <h3>{m.title}</h3>
            {m.description && <p class="special__desc">{m.description}</p>}
            {m.courses.length > 0 && (
              <div class="special__courses">
                {m.courses.map((c) => (
                  <div class="menu-day__course">
                    {c.title && <h4>{c.title}</h4>}
                    <ul role="list">{c.items.map((i) => <li>{i}</li>)}</ul>
                  </div>
                ))}
              </div>
            )}
            <div class="special__foot">
              {m.price && <p class="menu-day__price">{m.price}</p>}
              {m.price_note && <p class="menu-day__note">{m.price_note}</p>}
              <a class="btn btn--outline" href="#reservar">{t(lang, 'specials.book')}</a>
            </div>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>
)}
