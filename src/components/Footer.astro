---
import { site } from '../data/site';
import { publicUrl } from '../lib/base';
const year = new Date().getFullYear();
---
<footer class="footer">
  <div class="container footer__inner">
    <div class="brand brand--footer"><img src={publicUrl('logo.svg')} alt="" width="32" height="32" /><span>La Ximenera</span></div>
    <p>{site.address.street}, {site.address.postalCode} {site.address.city}, {site.address.region}</p>
    <p class="footer__social"><a href={site.instagram} target="_blank" rel="noopener">Instagram @laximenera_restaurante</a> · <a href={site.facebook} target="_blank" rel="noopener">Facebook</a></p>
    <p class="footer__small">© {year} La Ximenera · Restaurante en Alcoi · <a href="/aviso-legal">Aviso legal</a> · <a href="/privacidad">Privacidad</a> · <a href="/cookies">Cookies</a></p>
    <p class="footer__small">Web de demostración. Los datos entre corchetes están pendientes de confirmar.</p>
  </div>
</footer>
