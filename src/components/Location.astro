---
import { site } from '../data/site';
---
<section id="ubicacion" class="section location" aria-labelledby="location-title">
  <div class="container location__grid reveal">
    <div>
      <p class="eyebrow">Ubicación</p>
      <h2 id="location-title">Te esperamos <em>en Alcoi</em></h2>
      <address>
        {site.address.street}<br />{site.address.postalCode} {site.address.city}<br />{site.address.region}
      </address>
      <p class="location__note">Rooftop con terraza exterior, en el ático.</p>
      <a class="btn" href={site.mapsLink} target="_blank" rel="noopener">Abrir en Google Maps</a>
    </div>
    <div class="map">
      <iframe title="Mapa: La Ximenera - Rooftop, C/ Regiment Biscaia 2, Ático, Alcoy" src={site.mapsEmbed} loading="lazy" referrerpolicy="no-referrer-when-downgrade" allowfullscreen></iframe>
    </div>
  </div>
</section>
