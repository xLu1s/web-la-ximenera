---
import { Image } from 'astro:assets';
import Tbc from './Tbc.astro';
import { instagram, instagramCredit } from '../data/gallery';
// Foto oficial del Instagram @laximenera_restaurante: https://www.instagram.com/p/DcqG3KRI_a1/
import foto from '../assets/instagram/ig-05.jpg';
---
<section id="nosotros" class="section about" aria-labelledby="about-title">
  <div class="container about__grid">
    <div class="reveal">
      <p class="eyebrow">Nosotros · Rooftop</p>
      <h2 id="about-title">Un nuevo espacio singular <em>con encanto</em></h2>
      <p class="lead">Brasería mediterránea y cocina de producto, en el ático del número 2 de la calle Regiment Biscaia, en Alcoy.</p>
      <p>En nuestras brasas trabajamos con carnes y pescados nacionales, acompañados de verduras de temporada y patatas baby.</p>
      <p>Nuestros clientes destacan la sala amplia, con la bodega a la vista, y la terraza exterior.</p>
      <p>Nuestro nombre —<em>ximenera</em>, chimenea en valenciano— rinde homenaje a las chimeneas que dibujan el perfil industrial de Alcoi.</p>
      <p><Tbc label="Historia del restaurante, equipo y chef por confirmar" /></p>
      <ul class="facts" role="list">
        <li><strong>Brasería</strong><span>mediterránea</span></li>
        <li><strong>Producto</strong><span>carnes y pescados nacionales</span></li>
        <li><strong>Rooftop</strong><span>con terraza en Alcoi</span></li>
      </ul>
    </div>
    <figure class="about__photo reveal" style="--d:.15s">
      <Image src={foto} widths={[400, 640]} sizes="(min-width: 860px) 40vw, 90vw" alt="Carne de vaca a la brasa trinchada sobre tabla con verduras" />
      <figcaption><a href={instagram.url} target="_blank" rel="noopener">{instagramCredit}</a></figcaption>
    </figure>
  </div>
</section>
