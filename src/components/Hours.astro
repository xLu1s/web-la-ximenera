---
import { hoursTable, hoursSummary, type OpeningHour } from '../lib/hours';
import { publicLang, t } from '../i18n/public';
interface Props { hours: OpeningHour[] }
const lang = publicLang(Astro.locals.lang);
const rows = hoursTable(Astro.props.hours, lang);
const summary = hoursSummary(Astro.props.hours, lang);
---
<section id="horario" class="section hours" aria-labelledby="hours-title">
  <div class="container hours__grid reveal">
    <div>
      <p class="eyebrow">{t(lang, 'hours.eyebrow')}</p>
      <h2 id="hours-title" set:html={t(lang, 'hours.title')} />
      <p>{t(lang, 'hours.intro')}</p>
      {summary.length > 0 && <p>{summary.join(' ')}</p>}
    </div>
    <table class="hours__table" data-hours>
      <caption class="sr-only">{t(lang, 'hours.caption')}</caption>
      <tbody>
        {rows.map((h, i) => (
          <tr data-day={(i + 1) % 7}>
            <th scope="row">{h.day}</th>
            <td class:list={{ closed: h.value === 'Cerrado' }}>{h.value}</td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>
</section>
