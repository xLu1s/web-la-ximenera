---
import { hours } from '../data/site';
---
<section id="horario" class="section hours" aria-labelledby="hours-title">
  <div class="container hours__grid reveal">
    <div>
      <p class="eyebrow">Horario</p>
      <h2 id="hours-title">Cuándo encendemos <em>la brasa</em></h2>
      <p>Para grupos, recomendamos reservar con antelación, sobre todo los fines de semana.</p>
      <p>Cerramos los lunes. Domingos, solo mediodía.</p>
    </div>
    <table class="hours__table" data-hours>
      <caption class="sr-only">Horario semanal</caption>
      <tbody>
        {hours.map((h, i) => (
          <tr data-day={(i + 1) % 7}>
            <th scope="row">{h.day}</th>
            <td class:list={{ closed: h.value === 'Cerrado' }}>{h.value}</td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>
</section>
