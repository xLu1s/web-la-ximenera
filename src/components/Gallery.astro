---
import type { PublicContent } from '../lib/content';
import { publicLang, t } from '../i18n/public';
interface Props { items: PublicContent['gallery'] }
const items = Astro.props.items.filter((i) => i.visible && i.url);
const lang = publicLang(Astro.locals.lang);
---
<section id="galeria" class="section gallery" aria-labelledby="gallery-title">
  <div class="container gallery__head reveal">
    <div>
      <p class="eyebrow">{t(lang, 'gallery.eyebrow')}</p>
      <h2 id="gallery-title" set:html={t(lang, 'gallery.title')} />
    </div>
    <div class="gallery__nav">
      <button type="button" class="round-btn" data-gal-prev aria-label={t(lang, 'gallery.prev')}>‹</button>
      <button type="button" class="round-btn" data-gal-next aria-label={t(lang, 'gallery.next')}>›</button>
    </div>
  </div>
  <ul class="gallery__track" role="list" data-gal-track tabindex="0" aria-label={t(lang, 'gallery.carousel')}>
    {items.map((it) => (
      <li class="gallery__item" data-gallery-item>
        {it.media_type === 'video'
          ? <video src={it.url} controls muted playsinline preload="metadata" aria-label={it.caption}></video>
          : <img src={it.url} alt={it.caption} loading="lazy" decoding="async" />}
      </li>
    ))}
  </ul>
</section>
