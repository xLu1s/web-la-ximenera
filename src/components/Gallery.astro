---
import { instagram } from '../data/gallery';
import type { PublicContent } from '../lib/content';
interface Props { items: PublicContent['gallery'] }
const items = Astro.props.items.filter((i) => i.visible && i.url);
const hasProvisional = items.some((i) => i.is_provisional);
---
<section class="section gallery" aria-labelledby="gallery-title">
  <div class="container gallery__head reveal">
    <div>
      <p class="eyebrow">Galería</p>
      <h2 id="gallery-title">Del fuego <em>a la mesa</em></h2>
    </div>
    <div class="gallery__nav">
      <button type="button" class="round-btn" data-gal-prev aria-label="Foto anterior">‹</button>
      <button type="button" class="round-btn" data-gal-next aria-label="Foto siguiente">›</button>
    </div>
  </div>
  <ul class="gallery__track" role="list" data-gal-track tabindex="0" aria-label="Carrusel de fotos">
    {items.map((it) => (
      <li class="gallery__item" data-gallery-item>
        {it.media_type === 'video'
          ? <video src={it.url} controls muted playsinline preload="metadata" aria-label={it.caption}></video>
          : <img src={it.url} alt={it.caption} loading="lazy" decoding="async" />}
        {it.credit && <span class:list={['gallery__tag', { 'gallery__tag--client': it.is_provisional }]}>{it.credit}</span>}
      </li>
    ))}
  </ul>
  <p class="container gallery__credit">Fotos oficiales de <a href={instagram.url} target="_blank" rel="noopener">{instagram.handle}</a>.{hasProvisional && ' Las marcadas como «foto de cliente» son públicas (TripAdvisor / Sluurpy) y provisionales, pendientes de permiso.'}</p>
</section>
